# =============================================================================
# Vê AI · API .NET · modelo de variáveis de ambiente
# Copie para ".env" (cp .env.example .env) e ajuste. O ".env" NUNCA vai para o git.
# Convenção .NET: "__" separa seções (ConnectionStrings__Oracle -> ConnectionStrings:Oracle).
# Variáveis já definidas no sistema têm prioridade sobre este arquivo.
# =============================================================================

# ── Banco Oracle ──────────────────────────────────────────────────────────────
# Opção 1 (padrão): Oracle XE do docker-compose ("docker compose up -d oracle"), rodando a API com "dotnet run".
ConnectionStrings__Oracle=User Id=veai;Password=veai;Data Source=localhost:1521/XEPDB1

# Opção 2: Oracle da FIAP. Troque SEU_RM e SUA_SENHA pelos seus dados (só neste arquivo, nunca no código).
# O schema precisa ter rodado os scripts de database/oracle (ou o 00_instalar.sql do repositório database).
# ConnectionStrings__Oracle=User Id=SEU_RM;Password=SUA_SENHA;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle.fiap.com.br)(PORT=1521))(CONNECT_DATA=(SID=ORCL)))

# ── JWT ───────────────────────────────────────────────────────────────────────
# Chave HS256 com no mínimo 32 caracteres. Gere a sua com:  openssl rand -base64 48
# Sem ela, a API sobe com uma chave temporária (os tokens deixam de valer ao reiniciar).
Jwt__Segredo=
# Jwt__ValidadeHoras=8

# ── IA (descrição de imagens) ─────────────────────────────────────────────────
# falso = respostas fixas, sem custo (padrão, ideal para testes e demonstração)
# openai = modelo de visão real (gasta créditos; precisa da chave abaixo)
Ia__Provedor=falso
# OPENAI_API_KEY=
# Ia__Modelo=gpt-6-luna
# Ia__ReasoningEffort=low

# ── Rate limiting (requisições por minuto) ───────────────────────────────────
# RateLimit__FotosPorMinuto=20
# RateLimit__LoginPorMinuto=10
# RateLimit__RequisicoesPorMinuto=300

# ── Portas do docker-compose (opcional) ──────────────────────────────────────
# API_PORT=8081
# ORACLE_PORT=1521
